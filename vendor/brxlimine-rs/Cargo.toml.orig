[package]
name = "brxlimine-rs"
description = "BORUIX fork of limine-rs: Rust crate for parsing the limine boot protocol structures (matches brxLimine limine-protocol)"
version = "0.1.12"
edition = "2021"
authors = ["Anhad Singh <andypython@protonmail.com>"]
license = "MIT/Apache-2.0"
repository = "https://github.com/limine-bootloader/limine-rs"
readme = "README.md"
categories = ["no-std"]

[lib]
name = "limine"
path = "src/lib.rs"

[features]
requests-section = ["limine-proc"]
into-uuid = ["uuid"]
default = []

[dependencies]
limine-proc = { optional = true, version = "0.1.0" }
uuid = { optional = true, version = "1.1.2", default-features = false }
